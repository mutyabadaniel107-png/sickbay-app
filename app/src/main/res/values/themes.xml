<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">

    <style name="Theme.NewHighTechLab" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="colorPrimary">@color/brand_navy</item>
        <item name="colorPrimaryDark">@color/brand_navy_dark</item>
        <item name="colorAccent">@color/brand_red</item>
        <item name="android:statusBarColor" tools:targetApi="21">@color/brand_navy_dark</item>
        <item name="android:windowBackground">@color/off_white</item>
    </style>

    <!-- Shown the instant the app launches, before any layout inflates, so there's
         no white flash before the logo appears. -->
    <style name="Theme.NewHighTechLab.Splash" parent="Theme.NewHighTechLab">
        <item name="android:windowBackground">@drawable/bg_splash</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowFullscreen">false</item>
        <item name="android:statusBarColor" tools:targetApi="21">@color/white</item>
        <item name="android:windowLightStatusBar" tools:targetApi="23">true</item>
    </style>

</resources>
