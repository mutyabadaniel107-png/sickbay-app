<?xml version="1.0" encoding="utf-8"?>
<!--
    HTTPS only, using the device's normal trusted certificate store.
    This matches usesCleartextTraffic="false" in the manifest.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
